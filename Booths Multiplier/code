module booth_multiplier (
    input  signed [7:0] multiplicand,
    input  signed [7:0] multiplier,
    output reg signed [15:0] product
);
    logic signed [15:0] A, M;
    logic signed [8:0] Q; // Multiplier with extra Q-1 bit
    integer i;

    always @(*) begin
        // Initialize Registers
        A = 16'd0;           // Accumulator
        M = multiplicand;     // Multiplicand
        Q = {multiplier, 1'b0}; // Multiplier with Q_1 bit

        // Booth's Algorithm (8 iterations for 8-bit values)
        for (i = 0; i < 8; i = i + 1) begin
            case (Q[1:0])  // Check last two bits (Q0, Q-1)
                2'b01: A = A + M; // Add multiplicand
                2'b10: A = A - M; // Subtract multiplicand
                default: ;        // No operation (00 or 11)
            endcase

            // Arithmetic Right Shift (ARS) of {A, Q}
            {A, Q} = {A[15], A, Q[8:1]};
        end

        // Assign final product
        product = {A, Q[8:1]};  // Correct final concatenation
    end
endmodule

