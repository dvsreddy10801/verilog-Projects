`timescale 1ns / 1ps

module traffic_light_tb();

reg clk, reset;
wire R1, Y1, G1;
wire R2, Y2, G2;
wire R3, Y3, G3;
wire R4, Y4, G4;
wire [2:0] count;

traffic_light_controller uut (
    .clk(clk), .reset(reset),
    .count(count),
    .R1(R1), .Y1(Y1), .G1(G1),
    .R2(R2), .Y2(Y2), .G2(G2),
    .R3(R3), .Y3(Y3), .G3(G3),
    .R4(R4), .Y4(Y4), .G4(G4)
);

// Clock Generation
always #5 clk = ~clk;

initial begin
    $dumpfile("dump.vcd"); $dumpvars;

   #80 clk = 0;
    reset = 1;
    #10 reset = 0;

    #180 $finish;
end

endmodule
